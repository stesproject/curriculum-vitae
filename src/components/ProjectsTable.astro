---
import type { ProjectEntry } from '../types/cv';

interface Props {
  items: ProjectEntry[];
}

const { items } = Astro.props;
---

<table class="projects-table">
  <tbody>
    {
      items.map((item) => (
        <tr>
          <td class="project-name">
            {item.url ? (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="project-link">
                {item.name}
              </a>
            ) : (
              item.name
            )}
          </td>
          <td set:html={item.description} />
        </tr>
      ))
    }
  </tbody>
</table>

---
interface Props {
  currentLang: 'en' | 'de' | 'it';
  printButtonText: string;
}

const { currentLang, printButtonText } = Astro.props;
---

<div class="screen-actions">
  <button class="btn" onclick="window.print()">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
    </svg>
    {printButtonText}
  </button>
  <div class="lang-links">
    <a href="index.html" class={currentLang === 'en' ? 'active' : ''}>EN</a>
    <a href="index-de.html" class={currentLang === 'de' ? 'active' : ''}>DE</a>
    <a href="index-it.html" class={currentLang === 'it' ? 'active' : ''}>IT</a>
  </div>
</div>
